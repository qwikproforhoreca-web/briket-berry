# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/briket_berry

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=7d

# Admin credentials (used for seeding)
ADMIN_EMAIL=admin@briket-berry.ru
ADMIN_PASSWORD=SecureAdminPassword123!

# YooKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_RETURN_URL=https://briket-berry.ru/order/success

# Email (SMTP)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=bessonov@briket-berry.ru
SMTP_PASS=your-email-password
NOTIFICATION_EMAIL=orders@briket-berry.ru

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

# DeepSeek AI (консультант Огонёк)
OPENAI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://briket-berry.ru
